# Tolesh server configuration — copy to .env (git-ignored) and fill in.
# NEVER commit real keys. Frontend never sees these values.

# Port/host for the API server. Keep HOST on localhost unless you know why.
PORT=8787
HOST=127.0.0.1

# AI provider — Dahl (OpenAI-compatible chat completions schema).
# Get a key at https://inference.dahl.global/account  →  DAHL_API_KEY=sk-...
AI_PROVIDER=dahl
DAHL_BASE_URL=https://inference.dahl.global/v1
DAHL_API_KEY=

# Pin the model explicitly. If empty the gateway chooses, and the server warns at startup.
# Provisional choice (2026-10-19): deepseek-ai/DeepSeek-V4-Flash-0731. The GenSpark run on
# 2026-10-18 measured it 3–5× faster than the MiniMax default and it keeps reasoning out of
# `content`. That run has not been repeated: re-measure with `node eval/run.mjs` once a key exists.
DAHL_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Output budget per reply (tokens). Reasoning models spend tokens before answering.
# Ceiling 8192. One automatic retry with double budget if the reply runs out of room.
# MODEL_MAX_TOKENS=2048

# Reply language: 'mirror' (default, AGENTS.md rule) or 'pidgin' (natural Nigerian Pidgin by default).
# Pidgin is opt-in until the owner approves changing the default.
# REPLY_LANGUAGE_MODE=mirror

# Timezone used for "today" and "now" in replies.
# TOLESH_TIMEZONE=Africa/Lagos

# Conversation store (SQLite via node:sqlite). Default: server/data/tolesh.db
# DB_PATH=
# RATE_LIMIT_PER_MINUTE=60
# MODEL_TIMEOUT_MS=30000
# MODEL_MAX_RETRIES=2
